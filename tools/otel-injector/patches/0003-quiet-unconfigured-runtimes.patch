+test "doCheckPythonAutoInstrumentationAgentAndGetModifiedPythonpathValue: should return null if the prefix exists but has no build for the libc flavor" {
+    const allocator = testing.allocator;
+    _resetState();
+    defer _resetState();
+
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const prefix_path = try tmp.dir.realpathAlloc(allocator, ".");
+    defer allocator.free(prefix_path);
+
+    libc_info = test_util.testLibcInfo(.MUSL);
+    const modified_pythonpath_value =
+        doCheckPythonAutoInstrumentationAgentAndGetModifiedPythonpathValue(
+            allocator,
+            null,
+            prefix_path,
+            false,
+        );
+    try test_util.expectWithMessage(modified_pythonpath_value == null, "modified_pythonpath_value == null");
