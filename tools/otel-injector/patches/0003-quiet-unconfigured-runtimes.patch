+/// ADOT: the prefix exists but has no directory for this libc flavor -- the SDK simply has no build for it. That is
+/// expected (e.g. a musl application with a glibc-only SDK), not an error; this runs in every process, so log at
+/// debug and let the caller stand down.
+fn noBuildForThisLibc(configuration: config.InjectorConfiguration, libc_dir: []const u8) bool {
+    std.fs.cwd().access(libc_dir, .{}) catch {
+        std.fs.cwd().access(configuration.ruby_auto_instrumentation_agent_path_prefix, .{}) catch return false;
+        print.printDebug("Not injecting the Ruby auto-instrumentation: no build for this libc flavor in \"{s}\".", .{configuration.ruby_auto_instrumentation_agent_path_prefix});
+        return true;
+    };
+    return false;
+}
+
