+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//! ADOT start-up guard: stops injecting the auto-instrumentation into a container that keeps failing with it.
+//!
+//! Runs in every process before any environment variable is modified. Only the first process of a container run
+//! (a new PID 1 start time) updates the state; every other process of the same run reads the decision.
+//! The only setting is AWS_INSTRUMENTATION_GUARD_ENABLED=false (off). The guard only acts for the runtimes whose
+//! agent path is configured in this process. The state lives in the SDK volume, the parent directory of the
+//! injector/ directory that holds this libotelinject.so (taken from LD_PRELOAD); that volume (a Kubernetes emptyDir)
+//! keeps its content across container restarts. One file per writer, <id> = this container's name (from the kubelet's termination-log
+//! bind mount in /proc/self/mountinfo), else FNV-1a 32 of /proc/1/cmdline:
+//!   .adot-guard-<id>          written here: boot= fails= sdkcrash= skipped= skipfails= restored= pod=
+//!   .adot-guard-<id>.init     written by the SDK when it finished initialising: the boot id, then seconds since boot
+//!   .adot-guard-<id>.healthy  written by the SDK 60 s after that: the boot id
+//!   .adot-guard-<id>.crash    written by the SDK crash hook: the boot id, then "file:line ExcType"
+//! Any error -> behave exactly as without the guard (inject). See tools/otel-injector/SPEC.md.
+//! Uses raw Linux syscalls only (no libc, no std.posix wrappers with unreachable branches).
+
+const std = @import("std");
+const linux = std.os.linux;
+
+const auxv = @import("auxv.zig");
+const print = @import("print.zig");
+const proc_self_environ_parser = @import("proc_self_environ_parser.zig");
+
+const testing = std.testing;
+
+pub const injector_file_name = "libotelinject.so";
+
+const max_path = 1024;
+const max_file = 1024;
+
+pub const Config = struct {
+    max_failures: u32 = 3,
+    max_sdk_crashes: u32 = 2,
+    restore_after: u32 = 2,
+    crash_loop_seconds: u64 = 360,
+};
+
+pub const State = struct {
+    boot: u64 = 0,
+    fails: u32 = 0,
+    sdkcrash: u32 = 0,
+    skipped: bool = false,
+    skipfails: u32 = 0,
+    restored: bool = false,
+    pod: []const u8 = "",
+};
+
+/// What happened to the previous container run, as seen at the start of the next one.
+pub const Previous = struct {
+    healthy: bool,
+    sdk_crash: bool,
+    /// Seconds from the previous run's SDK-initialised time (else its start) to this start; null if not comparable.
+    seconds_since_start: ?u64,
+};
+
+pub const Transition = enum { none, fresh, started_skipping, still_skipping, restored, counted };
+
+pub const Decision = struct {
+    state: State,
+    skip: bool,
+    transition: Transition,
+};
+
+/// Pure decision for a new container run. prev_state is null for no (or unusable) state.
+pub fn decideNewRun(prev_state: ?State, prev: Previous, boot: u64, pod: []const u8, cfg: Config) Decision {
+    const p = prev_state orelse return .{ .state = .{ .boot = boot, .pod = pod }, .skip = false, .transition = .fresh };
+    const fast_fail = !prev.healthy and if (prev.seconds_since_start) |s| s < cfg.crash_loop_seconds else false;
+    var s = State{ .boot = boot, .pod = pod };
+    if (p.restored) {
+        // The app failed without the SDK as well: never skip again in this pod.
+        s.restored = true;
+        return .{ .state = s, .skip = false, .transition = .none };
+    }
+    if (p.skipped) {
+        s.fails = p.fails;
+        s.sdkcrash = p.sdkcrash;
+        s.skipfails = if (fast_fail) p.skipfails +| 1 else 0;
+        if (s.skipfails >= cfg.restore_after) {
+            s.restored = true;
+            return .{ .state = s, .skip = false, .transition = .restored };
+        }
+        s.skipped = true;
+        return .{ .state = s, .skip = true, .transition = .still_skipping };
+    }
+    s.fails = if (fast_fail) p.fails +| 1 else 0;
+    s.sdkcrash = if (prev.sdk_crash) p.sdkcrash +| 1 else 0;
+    if (s.fails >= cfg.max_failures or s.sdkcrash >= cfg.max_sdk_crashes) {
+        s.skipped = true;
+        return .{ .state = s, .skip = true, .transition = .started_skipping };
+    }
+    return .{ .state = s, .skip = false, .transition = .counted };
+}
+
+/// Parses "k=v k=v ..."; null if boot or fails are missing or malformed. pod points into content.
+pub fn parseState(content: []const u8) ?State {
+    var s = State{};
+    var have_boot = false;
+    var have_fails = false;
+    var it = std.mem.tokenizeAny(u8, content, " \t\r\n");
+    while (it.next()) |kv| {
+        const eq = std.mem.indexOfScalar(u8, kv, '=') orelse return null;
+        const k = kv[0..eq];
+        const v = kv[eq + 1 ..];
+        if (std.mem.eql(u8, k, "boot")) {
+            s.boot = std.fmt.parseInt(u64, v, 10) catch return null;
+            have_boot = true;
+        } else if (std.mem.eql(u8, k, "fails")) {
+            s.fails = std.fmt.parseInt(u32, v, 10) catch return null;
+            have_fails = true;
+        } else if (std.mem.eql(u8, k, "sdkcrash")) {
+            s.sdkcrash = std.fmt.parseInt(u32, v, 10) catch return null;
+        } else if (std.mem.eql(u8, k, "skipfails")) {
+            s.skipfails = std.fmt.parseInt(u32, v, 10) catch return null;
+        } else if (std.mem.eql(u8, k, "skipped")) {
+            s.skipped = std.mem.eql(u8, v, "1");
+        } else if (std.mem.eql(u8, k, "restored")) {
+            s.restored = std.mem.eql(u8, v, "1");
+        } else if (std.mem.eql(u8, k, "pod")) {
+            s.pod = v;
+        }
+    }
+    if (!have_boot or !have_fails) return null;
+    return s;
+}
+
+pub fn formatState(buf: []u8, s: State) ![]u8 {
+    return std.fmt.bufPrint(buf, "boot={d} fails={d} pod={s} restored={d} sdkcrash={d} skipfails={d} skipped={d}\n", .{
+        s.boot, s.fails, s.pod, @intFromBool(s.restored), s.sdkcrash, s.skipfails, @intFromBool(s.skipped),
+    });
+}
+
+pub fn fnv1a32(data: []const u8) u32 {
+    var h: u32 = 0x811C9DC5;
+    for (data) |b| h = (h ^ b) *% 0x01000193;
+    return h;
+}
+
+/// Field 22 (starttime, clock ticks since boot) of a /proc/<pid>/stat line.
+pub fn parseStartTime(stat: []const u8) ?u64 {
+    const rp = std.mem.lastIndexOfScalar(u8, stat, ')') orelse return null;
+    var it = std.mem.tokenizeAny(u8, stat[rp + 1 ..], " \n");
+    var i: usize = 0;
+    while (it.next()) |tok| : (i += 1) {
+        if (i == 19) return std.fmt.parseInt(u64, tok, 10) catch null;
+    }
+    return null;
+}
+
+fn isPause(cmdline: []const u8) bool {
+    const argv0 = cmdline[0 .. std.mem.indexOfScalar(u8, cmdline, 0) orelse cmdline.len];
+    const base = argv0[(if (std.mem.lastIndexOfScalar(u8, argv0, '/')) |i| i + 1 else 0)..];
+    return std.mem.eql(u8, base, "pause");
+}
+
+// ---- raw syscall I/O (errors are values, never panics) ----
+
+const IoError = error{ Syscall, PathTooLong, ShortWrite };
+
+fn ok(rc: usize) IoError!usize {
+    // Raw syscall convention: values in (-4096, -1] are -errno. (std.posix.errno would read libc's errno when
+    // linked against libc, as in the unit tests.)
+    const signed: isize = @bitCast(rc);
+    if (signed < 0 and signed > -4096) return error.Syscall;
+    return rc;
+}
+
+fn toZ(buf: []u8, path: []const u8) IoError![:0]const u8 {
+    if (path.len + 1 > buf.len) return error.PathTooLong;
+    @memcpy(buf[0..path.len], path);
+    buf[path.len] = 0;
+    return buf[0..path.len :0];
+}
+
+/// Reads up to buf.len bytes; null if the file does not exist or cannot be read.
+fn readFile(path: []const u8, buf: []u8) ?[]u8 {
+    var pbuf: [max_path]u8 = undefined;
+    const pz = toZ(&pbuf, path) catch return null;
+    const fd_rc = ok(linux.openat(linux.AT.FDCWD, pz, .{ .ACCMODE = .RDONLY, .CLOEXEC = true, .NOFOLLOW = true }, 0)) catch return null;
+    const fd: i32 = @intCast(fd_rc);
+    defer _ = linux.close(fd);
+    var n: usize = 0;
+    while (n < buf.len) {
+        const r = ok(linux.read(fd, buf[n..].ptr, buf.len - n)) catch return null;
+        if (r == 0) break;
+        n += r;
+    }
+    return buf[0..n];
+}
+
+fn writeAll(fd: i32, data: []const u8) IoError!void {
+    var off: usize = 0;
+    while (off < data.len) {
+        const w = try ok(linux.write(fd, data[off..].ptr, data.len - off));
+        if (w == 0) return error.ShortWrite;
+        off += w;
+    }
+}
+
+/// Writes a new file next to path and renames it over path, so readers never see a partial file.
+fn writeFileAtomic(path: []const u8, data: []const u8) IoError!void {
+    var rnd: [4]u8 = .{ 0, 0, 0, 0 };
+    _ = linux.getrandom(&rnd, rnd.len, 0);
+    var tbuf: [max_path]u8 = undefined;
+    const tmp = std.fmt.bufPrintZ(&tbuf, "{s}.{d}.{x}", .{ path, linux.getpid(), std.mem.readInt(u32, &rnd, .little) }) catch return error.PathTooLong;
+    var pbuf: [max_path]u8 = undefined;
+    const pz = try toZ(&pbuf, path);
+    const fd_rc = try ok(linux.openat(linux.AT.FDCWD, tmp, .{ .ACCMODE = .WRONLY, .CREAT = true, .EXCL = true, .NOFOLLOW = true, .CLOEXEC = true }, 0o666));
+    const fd: i32 = @intCast(fd_rc);
+    writeAll(fd, data) catch |err| {
+        _ = linux.close(fd);
+        _ = linux.unlinkat(linux.AT.FDCWD, tmp, 0);
+        return err;
+    };
+    _ = linux.close(fd);
+    _ = ok(linux.renameat(linux.AT.FDCWD, tmp, linux.AT.FDCWD, pz)) catch |err| {
+        _ = linux.unlinkat(linux.AT.FDCWD, tmp, 0);
+        return err;
+    };
+}
+
+fn stderrLine(comptime fmt: []const u8, args: anytype) void {
+    var buf: [1024]u8 = undefined;
+    const line = std.fmt.bufPrint(&buf, "[adot-guard] " ++ fmt ++ "\n", args) catch return;
+    writeAll(2, line) catch {};
+}
+
+fn basename(path: []const u8) []const u8 {
+    return path[(if (std.mem.lastIndexOfScalar(u8, path, '/')) |i| i + 1 else 0)..];
+}
+
+fn dirname(path: []const u8) []const u8 {
+    const i = std.mem.lastIndexOfScalar(u8, path, '/') orelse return "";
+    return if (i == 0) "/" else path[0..i];
+}
+
+/// The state directory: the SDK volume holding this injector. LD_PRELOAD entries are separated by ':' or ' '; the
+/// one named libotelinject.so (absolute path) is ours. <volume>/injector/libotelinject.so -> <volume> (the emptyDir
+/// root, writable by any user); a libotelinject.so directly in a directory -> that directory.
+pub fn stateDirFromLdPreload(ld_preload: []const u8) ?[]const u8 {
+    var it = std.mem.tokenizeAny(u8, ld_preload, ": ");
+    while (it.next()) |entry| {
+        if (entry.len == 0 or entry[0] != '/') continue;
+        if (!std.mem.eql(u8, basename(entry), injector_file_name)) continue;
+        const dir = dirname(entry);
+        if (std.mem.eql(u8, basename(dir), "injector")) {
+            const parent = dirname(dir);
+            return if (parent.len > 1) parent else null;
+        }
+        return if (dir.len > 1) dir else null;
+    }
+    return null;
+}
+
+/// This container's name, from the kubelet's termination-log bind mount: a /proc/self/mountinfo line whose root
+/// (field 4) ends in /pods/<pod uid>/containers/<container name>/<suffix>. The suffix changes on every restart, the
+/// name does not. Null if there is no such mount.
+pub fn containerNameFromMountinfo(mountinfo: []const u8) ?[]const u8 {
+    var lines = std.mem.splitScalar(u8, mountinfo, '\n');
+    while (lines.next()) |line| {
+        var fields = std.mem.tokenizeScalar(u8, line, ' ');
+        var i: usize = 0;
+        var root: []const u8 = "";
+        while (fields.next()) |f| : (i += 1) {
+            if (i == 3) {
+                root = f;
+                break;
+            }
+        }
+        if (root.len == 0) continue;
+        // last five components: pods, <uid>, containers, <name>, <suffix>
+        var comps: [5][]const u8 = undefined;
+        var n: usize = 0;
+        var rest = root;
+        while (n < 5) : (n += 1) {
+            const j = std.mem.lastIndexOfScalar(u8, rest, '/') orelse break;
+            comps[4 - n] = rest[j + 1 ..];
+            rest = rest[0..j];
+        }
+        if (n < 5) continue;
+        if (!std.mem.eql(u8, comps[0], "pods") or !std.mem.eql(u8, comps[2], "containers")) continue;
+        if (comps[1].len != 36 or comps[3].len == 0 or comps[3].len > 63 or comps[4].len == 0) continue;
+        var valid = true;
+        for (comps[3]) |c| {
+            if (!(std.ascii.isLower(c) or std.ascii.isDigit(c) or c == '-' or c == '.')) valid = false;
+        }
+        if (valid) return comps[3];
+    }
+    return null;
+}
+
+/// "<boot id>\n<seconds since node boot>\n" -> seconds, if the boot id matches.
+fn parseInitFile(content: []const u8, boot: u64) ?u64 {
+    var it = std.mem.tokenizeAny(u8, content, " \r\n");
+    const b = it.next() orelse return null;
+    if ((std.fmt.parseInt(u64, b, 10) catch return null) != boot) return null;
+    const secs = it.next() orelse return null;
+    const dot = std.mem.indexOfScalar(u8, secs, '.') orelse secs.len;
+    return std.fmt.parseInt(u64, secs[0..dot], 10) catch null;
+}
+
+/// True for a temporary file left by an interrupted atomic write of one of this container's files:
+/// "<base>.<anything>" where <base> is ".adot-guard-<id>" and the rest is not one of the known suffixes.
+pub fn isStaleTemp(name: []const u8, base: []const u8) bool {
+    if (!std.mem.startsWith(u8, name, base) or name.len <= base.len + 1 or name[base.len] != '.') return false;
+    const rest = name[base.len + 1 ..];
+    for ([_][]const u8{ "init", "healthy", "crash" }) |known| {
+        if (std.mem.eql(u8, rest, known)) return false;
+    }
+    // temporary names end in ".<pid>.<hex>" (from any of the writers)
+    return std.mem.indexOfScalar(u8, rest, '.') != null or std.ascii.isDigit(rest[0]);
+}
+
+/// Removes temporary files of this container left by interrupted writes (a process killed between creating and
+/// renaming), so the number of our files never grows with the restart count. Best effort.
+fn removeStaleTemps(dir: []const u8, base: []const u8) void {
+    var pbuf: [max_path]u8 = undefined;
+    const dz = toZ(&pbuf, dir) catch return;
+    const fd_rc = ok(linux.openat(linux.AT.FDCWD, dz, .{ .ACCMODE = .RDONLY, .DIRECTORY = true, .CLOEXEC = true }, 0)) catch return;
+    const fd: i32 = @intCast(fd_rc);
+    defer _ = linux.close(fd);
+    var buf: [8192]u8 align(8) = undefined;
+    var rounds: usize = 0;
+    while (rounds < 64) : (rounds += 1) {
+        const n = ok(linux.getdents64(fd, &buf, buf.len)) catch return;
+        if (n == 0) return;
+        var off: usize = 0;
+        while (off + 19 < n) {
+            const reclen = std.mem.readInt(u16, buf[off + 16 ..][0..2], .little);
+            if (reclen == 0 or off + reclen > n) return;
+            const name = std.mem.sliceTo(buf[off + 19 .. off + reclen], 0);
+            if (isStaleTemp(name, base)) {
+                var nbuf: [max_path]u8 = undefined;
+                if (toZ(&nbuf, name)) |nz| {
+                    _ = linux.unlinkat(fd, nz, 0);
+                } else |_| {}
+            }
+            off += reclen;
+        }
+    }
+}
+
+// ---- evaluation ----
+
+pub const Env = struct {
+    k8s: bool,
+    enabled: bool,
+    state_dir: ?[]const u8,
+    container_name: ?[]const u8,
+    /// The languages this injector manages in this process (those whose agent path is configured), e.g. "python"
+    /// or "java,python". Empty: the injector manages none, so the guard does nothing. null (tests): unspecified.
+    languages: ?[]const u8 = null,
+    cfg: Config = .{},
+};
+
+pub const Proc = struct {
+    cmdline: []const u8,
+    boot: u64,
+    pod: []const u8,
+    clk_tck: u64,
+};
+
+pub const Result = enum {
+    /// The guard does not apply (or failed): inject as usual.
+    off,
+    /// Inject as usual; the guard is active for this run.
+    inject,
+    /// Do not inject anything.
+    skip,
+};
+
+/// Evaluates the guard for this process. path_buf is scratch space for the state file path.
+pub fn evaluateWith(env: Env, proc: Proc, path_buf: []u8) Result {
+    if (!env.k8s or !env.enabled) return .off;
+    // Nothing managed by the injector here (e.g. every language uses the old injection): nothing to protect, so
+    // do not count, skip or log.
+    const langs = env.languages orelse "the auto-instrumentation";
+    if (langs.len == 0) return .off;
+    const dir = env.state_dir orelse return .off;
+    if (dir.len == 0 or dir[0] != '/') return .off;
+    if (isPause(proc.cmdline)) {
+        print.printDebug("adot-guard: off, PID 1 is the pod's pause process (shareProcessNamespace)", .{});
+        return .off;
+    }
+    var idbuf: [16]u8 = undefined;
+    const id = if (env.container_name) |g| g else std.fmt.bufPrint(&idbuf, "{x:0>8}", .{fnv1a32(proc.cmdline)}) catch return .off;
+    if (id.len == 0 or std.mem.indexOfScalar(u8, id, '/') != null) return .off;
+    const path = std.fmt.bufPrint(path_buf, "{s}/.adot-guard-{s}", .{ std.mem.trimRight(u8, dir, "/"), id }) catch return .off;
+
+    var sbuf: [max_file]u8 = undefined;
+    var prev_state: ?State = if (readFile(path, &sbuf)) |c| parseState(c) else null;
+    if (prev_state) |p| {
+        if (!std.mem.eql(u8, p.pod, proc.pod)) prev_state = null; // left by another pod
+    }
+    if (prev_state) |p| {
+        if (p.boot == proc.boot) {
+            // Same container run: the first process already decided.
+            if (p.skipped) return .skip;
+            return .inject;
+        }
+    }
+
+    // A new container run: look at how the previous run ended.
+    var prev = Previous{ .healthy = false, .sdk_crash = false, .seconds_since_start = null };
+    var crash_desc: []const u8 = "";
+    var hbuf: [64]u8 = undefined;
+    var cbuf: [max_file]u8 = undefined;
+    var ibuf: [128]u8 = undefined;
+    var xbuf: [max_path]u8 = undefined;
+    if (prev_state) |p| {
+        if (proc.clk_tck > 0 and proc.boot >= p.boot) {
+            const now_s = proc.boot / proc.clk_tck;
+            prev.seconds_since_start = (proc.boot - p.boot) / proc.clk_tck;
+            // Measure from when the SDK finished initialising, if it did: a slow SDK start-up then does not hide a
+            // crash right after it.
+            const ip = std.fmt.bufPrint(&xbuf, "{s}.init", .{path}) catch return .off;
+            if (readFile(ip, &ibuf)) |c| {
+                if (parseInitFile(c, p.boot)) |init_s| {
+                    if (now_s >= init_s) prev.seconds_since_start = now_s - init_s;
+                }
+            }
+        }
+        const hp = std.fmt.bufPrint(&xbuf, "{s}.healthy", .{path}) catch return .off;
+        if (readFile(hp, &hbuf)) |h| {
+            prev.healthy = (std.fmt.parseInt(u64, std.mem.trim(u8, h, " \r\n"), 10) catch 0) == p.boot;
+        }
+        const cp = std.fmt.bufPrint(&xbuf, "{s}.crash", .{path}) catch return .off;
+        if (readFile(cp, &cbuf)) |c| {
+            const nl = std.mem.indexOfScalar(u8, c, '\n') orelse c.len;
+            if ((std.fmt.parseInt(u64, std.mem.trim(u8, c[0..nl], " \r"), 10) catch 0) == p.boot) {
+                prev.sdk_crash = true;
+                crash_desc = std.mem.trim(u8, c[@min(nl + 1, c.len)..], " \r\n");
+            }
+        }
+    }
+
+    removeStaleTemps(std.mem.trimRight(u8, dir, "/"), basename(path));
+    const d = decideNewRun(prev_state, prev, proc.boot, proc.pod, env.cfg);
+    var obuf: [max_file]u8 = undefined;
+    const out = formatState(&obuf, d.state) catch return .off;
+    writeFileAtomic(path, out) catch |err| {
+        // No writable volume: the guard turns itself off and the SDK loads as usual. Said once per container run
+        // (by PID 1, the first process), not in every process.
+        if (linux.getpid() == 1) {
+            stderrLine("start-up check is off: cannot write {s} ({})", .{ path, err });
+        } else {
+            print.printDebug("adot-guard: start-up check is off, cannot write {s}: {}", .{ path, err });
+        }
+        return .off;
+    };
+
+    switch (d.transition) {
+        .started_skipping => {
+            if (d.state.sdkcrash >= env.cfg.max_sdk_crashes) {
+                stderrLine("ADOT SDK skipped for {s}: the application crashed inside the SDK {d} times in a row (last: {s})", .{ langs, d.state.sdkcrash, crash_desc });
+            } else {
+                stderrLine("ADOT SDK skipped for {s}: this container failed to start {d} times in a row with it", .{ langs, d.state.fails });
+            }
+        },
+        .still_skipping => stderrLine("ADOT SDK skipped for {s} (decided earlier in this pod)", .{langs}),
+        .restored => stderrLine("ADOT SDK restored for {s}: the container kept failing without it, so the SDK was not the cause", .{langs}),
+        else => {},
+    }
+    return if (d.skip) .skip else .inject;
+}
+
+/// Production entry point: reads the environment from /proc/self/environ and process data from /proc.
+pub fn evaluate(allocator: std.mem.Allocator, path_buf: []u8) Result {
+    const getenv = proc_self_environ_parser.getenv;
+    const k8s = getenv(allocator, "KUBERNETES_SERVICE_HOST");
+    defer if (k8s) |v| allocator.free(v);
+    if (k8s == null or k8s.?.len == 0) return .off;
+    const enabled = getenv(allocator, "AWS_INSTRUMENTATION_GUARD_ENABLED");
+    defer if (enabled) |v| allocator.free(v);
+    if (enabled) |v| {
+        if (std.ascii.eqlIgnoreCase(v, "false")) return .off;
+    }
+    const ld_preload = getenv(allocator, "LD_PRELOAD");
+    defer if (ld_preload) |v| allocator.free(v);
+    const state_dir = stateDirFromLdPreload(ld_preload orelse return .off) orelse return .off;
+
+    // Languages this injector manages here: those whose agent path the operator configured. Others (e.g. a language
+    // still injected the old way in a mixed per-language setup) are not affected by the guard.
+    var lbuf: [64]u8 = undefined;
+    var llen: usize = 0;
+    inline for (.{
+        .{ "JVM_AUTO_INSTRUMENTATION_AGENT_PATH", "java" },
+        .{ "NODEJS_AUTO_INSTRUMENTATION_AGENT_PATH", "nodejs" },
+        .{ "PYTHON_AUTO_INSTRUMENTATION_AGENT_PATH_PREFIX", "python" },
+        .{ "DOTNET_AUTO_INSTRUMENTATION_AGENT_PATH_PREFIX", "dotnet" },
+        .{ "RUBY_AUTO_INSTRUMENTATION_AGENT_PATH_PREFIX", "ruby" },
+    }) |pair| {
+        const v = getenv(allocator, pair[0]);
+        defer if (v) |x| allocator.free(x);
+        if (v) |x| {
+            if (x.len > 0) {
+                const sep: []const u8 = if (llen > 0) "," else "";
+                const w = std.fmt.bufPrint(lbuf[llen..], "{s}{s}", .{ sep, pair[1] }) catch return .off;
+                llen += w.len;
+            }
+        }
+    }
+    if (llen == 0) return .off;
+
+    const mibuf = allocator.alloc(u8, 256 * 1024) catch return .off;
+    defer allocator.free(mibuf);
+    const name: ?[]const u8 = if (readFile("/proc/self/mountinfo", mibuf)) |mi| containerNameFromMountinfo(mi) else null;
+
+    var cmdbuf: [4096]u8 = undefined;
+    const cmdline = readFile("/proc/1/cmdline", &cmdbuf) orelse return .off;
+    var statbuf: [2048]u8 = undefined;
+    const stat = readFile("/proc/1/stat", &statbuf) orelse return .off;
+    const boot = parseStartTime(stat) orelse return .off;
+    var uts: linux.utsname = undefined;
+    _ = ok(linux.uname(&uts)) catch return .off;
+    const pod = std.mem.sliceTo(&uts.nodename, 0);
+    var clk: u64 = auxv.getauxval(17);
+    if (clk == 0) clk = 100;
+
+    return evaluateWith(.{
+        .k8s = true,
+        .enabled = true,
+        .state_dir = state_dir,
+        .container_name = name,
+        .languages = lbuf[0..llen],
+    }, .{ .cmdline = cmdline, .boot = boot, .pod = pod, .clk_tck = clk }, path_buf);
+}
